---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SectionTitle from "../components/SectionTitle.astro";

const aboutCards = [
  {
    title: "Web Development Background",
    text: "Over 12 years of experience building websites, web applications and custom digital systems for businesses and organisations.",
  },
  {
    title: "WordPress & CMS Expertise",
    text: "Strong experience with WordPress, Elementor, ACF, custom post types, shortcodes, performance optimisation and custom functionality.",
  },
  {
    title: "Business System Thinking",
    text: "Experience planning and building practical systems such as payroll, attendance, leave management, inventory, purchase and sales workflows.",
  },
];

const focusAreas = [
  "Fast personal and business websites",
  "WordPress to static website migration",
  "Laravel and PHP web applications",
  "Angular and frontend interfaces",
  "Custom business workflows",
  "Clean, maintainable code structure",
];

const skillGroups = [
  {
    category: "Frontend Development",
    description: "Building clean, responsive and interactive interfaces.",
    items: ["HTML", "CSS", "JavaScript", "TypeScript", "Angular", "Tailwind CSS", "Astro"],
  },
  {
    category: "Backend Development",
    description: "Developing APIs, application logic and database-connected systems.",
    items: ["PHP", "Laravel", "MySQL", "REST APIs", "Authentication", "CRUD Systems"],
  },
  {
    category: "WordPress & CMS",
    description: "Customising WordPress beyond standard themes and plugins.",
    items: ["WordPress", "Elementor", "ACF", "Custom Post Types", "Shortcodes", "Custom Plugins"],
  },
  {
    category: "Business Systems",
    description: "Planning and building practical systems for real business operations.",
    items: ["Payroll", "Attendance", "Leave Management", "Inventory", "Purchase", "Sales"],
  },
];

const skillMeters = [
  { label: "WordPress / Elementor", level: 95 },
  { label: "PHP / MySQL", level: 90 },
  { label: "Laravel", level: 85 },
  { label: "Angular", level: 82 },
  { label: "System Analysis", level: 88 },
];

const projects = [
  {
    title: "Kasthamandap Supermercado",
    type: "Laravel eCommerce Website",
    description:
      "A modern eCommerce website with product management, checkout, order handling and Filament-powered admin controls.",
    tags: ["Laravel", "Filament", "Livewire", "Tailwind", "MySQL"],
    features: ["Product catalogue", "Checkout flow", "Admin panel", "Order management"],
  },
  {
    title: "Payroll & Inventory Management System",
    type: "Business Management System",
    description:
      "A custom Angular, PHP and MySQL-based system covering employee profiles, attendance, leave, salary, payroll, inventory, purchase and sales.",
    tags: ["Angular", "PHP", "MySQL", "REST API", "Payroll"],
    features: ["Attendance", "Leave requests", "Payroll", "Inventory", "Sales & purchase"],
  },
  {
    title: "NEPAFE Website",
    type: "WordPress / Elementor Website",
    description:
      "A WordPress website using Elementor, ACF, custom post types, useful links, filtering logic and content management features.",
    tags: ["WordPress", "Elementor", "ACF", "PHP", "CPT"],
    features: ["Custom post types", "ACF filters", "Useful links", "Popup content"],
  },
  {
    title: "Calorie Calculator App",
    type: "Full-stack Health Tracking App",
    description:
      "A calorie tracking application designed to manage food records, custom food entries and nutrition-related calculations through a structured backend API.",
    tags: ["Laravel", "API", "Database", "Authentication", "Food Tracking"],
    features: ["Food database", "Custom food entries", "Calorie tracking", "API-based structure"],
  },
  {
    title: "World Cup 2026 Predictor",
    type: "Interactive Prediction App",
    description:
      "An interactive football prediction application for the 2026 World Cup, designed around match predictions, tournament logic and user-friendly result tracking.",
    tags: ["Prediction App", "Football", "World Cup 2026", "Frontend", "Interactive UI"],
    features: ["Match predictions", "Tournament flow", "Result tracking", "Interactive experience"],
  },
  {
    title: "Personal Static Website",
    type: "Astro Portfolio Website",
    description:
      "A lightweight static personal website replacing WordPress, designed for speed, cleaner maintenance and Render deployment.",
    tags: ["Astro", "Tailwind", "Static Site", "Render"],
    features: ["No database", "No plugins", "Fast loading", "Git deployment"],
  },
];
---

<BaseLayout>
  <Header />

  <main class="min-h-screen">
    <section id="home" class="relative flex min-h-screen items-center overflow-hidden px-6 py-32">
      <div class="absolute inset-0 -z-20 bg-[linear-gradient(135deg,_#0f172a_0%,_#020617_55%,_#111827_100%)]"></div>

      <div class="pulse-soft absolute left-[-8rem] top-24 -z-10 h-80 w-80 rounded-full bg-[#F08252]/20 blur-3xl"></div>
      <div class="pulse-soft absolute bottom-10 right-[-10rem] -z-10 h-96 w-96 rounded-full bg-orange-500/10 blur-3xl"></div>

      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(240,130,82,0.16),_transparent_32%),radial-gradient(circle_at_bottom_right,_rgba(255,255,255,0.06),_transparent_28%)]"></div>

      <div class="mx-auto grid w-full max-w-6xl gap-14 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
        <div>
          <p class="mb-5 inline-flex rounded-full border border-orange-300/20 bg-orange-300/10 px-4 py-2 text-sm font-medium text-orange-200">
            Available for website, WordPress and custom web system projects
          </p>

          <h1 class="max-w-4xl text-5xl font-bold tracking-tight text-white md:text-7xl">
            Hi, I’m
            <span class="block bg-gradient-to-r from-[#F08252] to-orange-300 bg-clip-text text-transparent">
              Siddhartha Gautam
            </span>
          </h1>

          <p class="mt-6 max-w-2xl text-xl font-medium text-slate-200 md:text-2xl">
            Web Developer · WordPress Specialist · System Analyst
          </p>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            I build fast, practical and business-focused websites and web applications
            using WordPress, Laravel, Angular, PHP, MySQL and modern frontend tools.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {["WordPress", "Laravel", "Angular", "PHP", "MySQL", "Tailwind CSS"].map((item) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
                {item}
              </span>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#projects"
              class="rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-500"
            >
              View My Work
            </a>

            <a
              href="#contact"
              class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-[#F08252] hover:text-[#F08252]"
            >
              Contact Me
            </a>
          </div>

          <div class="mt-12 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/10 pt-8">
            <div>
              <p class="text-3xl font-bold text-white">12+</p>
              <p class="mt-1 text-sm text-slate-400">Years experience</p>
            </div>

            <div>
              <p class="text-3xl font-bold text-white">100+</p>
              <p class="mt-1 text-sm text-slate-400">Web projects</p>
            </div>

            <div>
              <p class="text-3xl font-bold text-white">Full</p>
              <p class="mt-1 text-sm text-slate-400">Stack approach</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="float-soft absolute -right-4 -top-6 hidden rounded-2xl border border-white/10 bg-white/10 px-5 py-4 shadow-2xl backdrop-blur md:block">
            <p class="text-sm font-medium text-slate-300">Current stack</p>
            <p class="mt-1 text-lg font-semibold text-white">Astro + Tailwind</p>
          </div>

          <div class="rounded-[2rem] border border-white/10 bg-white/5 p-4 shadow-2xl backdrop-blur">
            <div class="overflow-hidden rounded-[1.5rem] bg-slate-900">
              <div class="bg-gradient-to-br from-[#F08252] via-orange-500 to-slate-800 p-1">
                <div class="rounded-[1.35rem] bg-slate-950 p-6">
                  <div class="flex items-center gap-4">
                    <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-[#F08252] text-3xl font-bold text-white shadow-lg shadow-orange-500/30">
                      SG
                    </div>

                    <div>
                      <p class="text-xl font-bold text-white">Siddhartha Gautam</p>
                      <p class="mt-1 text-sm text-slate-400">Developer / System Analyst</p>
                    </div>
                  </div>

                  <div class="mt-8 space-y-4">
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                      <p class="text-sm text-slate-400">Main focus</p>
                      <p class="mt-2 text-lg font-semibold text-white">
                        Lightweight, fast and maintainable websites
                      </p>
                    </div>

                    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                      <p class="text-sm text-slate-400">Project type</p>
                      <p class="mt-2 text-lg font-semibold text-white">
                        Personal portfolio replacing WordPress
                      </p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                      <div class="rounded-2xl bg-white/5 p-4">
                        <p class="text-2xl font-bold text-[#F08252]">No</p>
                        <p class="mt-1 text-sm text-slate-400">Database</p>
                      </div>

                      <div class="rounded-2xl bg-white/5 p-4">
                        <p class="text-2xl font-bold text-[#F08252]">No</p>
                        <p class="mt-1 text-sm text-slate-400">Plugins</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="border-t border-white/10 bg-white/[0.03] p-6">
                <div class="flex flex-wrap gap-2">
                  {["Fast", "SEO-ready", "Responsive", "Render deploy"].map((item) => (
                    <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="float-soft absolute -bottom-6 -left-4 hidden rounded-2xl border border-white/10 bg-slate-900 px-5 py-4 shadow-2xl md:block">
            <p class="text-sm text-slate-400">Website goal</p>
            <p class="mt-1 font-semibold text-white">Fast personal brand site</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="relative overflow-hidden px-6 py-24">
      <div class="absolute left-[-12rem] top-20 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl"></div>

      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="About"
          title="Developer, problem solver and system thinker"
          description="I create practical digital solutions that combine clean design, reliable development and business-focused functionality."
        />

        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div class="rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F08252]">
              Personal Profile
            </p>

            <h3 class="mt-5 text-3xl font-bold tracking-tight text-white">
              Building websites and systems that are practical, fast and useful.
            </h3>

            <div class="mt-6 space-y-5 text-lg leading-8 text-slate-300">
              <p>
                I am a web developer and system analyst with experience across
                WordPress, Elementor, PHP, Laravel, Angular, MySQL and modern
                frontend development.
              </p>

              <p>
                My work focuses on solving real problems through clean websites,
                practical business systems and maintainable digital solutions.
                I enjoy working on projects where design, functionality and business
                needs come together.
              </p>

              <p>
                This website is being rebuilt as a lightweight static site to replace
                WordPress, improve speed, reduce maintenance and create a cleaner
                personal brand presence.
              </p>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="rounded-2xl bg-slate-950/70 p-5">
                <p class="text-3xl font-bold text-[#F08252]">12+</p>
                <p class="mt-1 text-sm text-slate-400">Years experience</p>
              </div>

              <div class="rounded-2xl bg-slate-950/70 p-5">
                <p class="text-3xl font-bold text-[#F08252]">100+</p>
                <p class="mt-1 text-sm text-slate-400">Web projects</p>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="grid gap-6">
              {aboutCards.map((card) => (
                <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07]">
                  <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F08252]/15 text-lg font-bold text-[#F08252]">
                    ✓
                  </div>

                  <h3 class="text-xl font-semibold text-white">
                    {card.title}
                  </h3>

                  <p class="mt-3 leading-7 text-slate-300">
                    {card.text}
                  </p>
                </article>
              ))}
            </div>

            <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6">
              <h3 class="text-xl font-semibold text-white">
                Current focus areas
              </h3>

              <div class="mt-5 flex flex-wrap gap-3">
                {focusAreas.map((item) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="relative overflow-hidden bg-slate-900/50 px-6 py-24">
      <div class="absolute right-[-12rem] top-24 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl"></div>

      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="Skills"
          title="Technology stack and practical expertise"
          description="A balanced mix of frontend, backend, WordPress, CMS and business system development skills."
        />

        <div class="grid gap-6 lg:grid-cols-2">
          {skillGroups.map((group) => (
            <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07]">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-2xl font-semibold text-white">
                    {group.category}
                  </h3>

                  <p class="mt-3 leading-7 text-slate-300">
                    {group.description}
                  </p>
                </div>

                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#F08252]/15 text-xl font-bold text-[#F08252]">
                  #
                </div>
              </div>

              <div class="mt-6 flex flex-wrap gap-3">
                {group.items.map((item) => (
                  <span class="rounded-full border border-white/10 bg-slate-950/60 px-4 py-2 text-sm text-slate-300 transition group-hover:border-[#F08252]/30">
                    {item}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 grid gap-8 rounded-[2rem] border border-white/10 bg-slate-950/70 p-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F08252]">
              Capability Overview
            </p>

            <h3 class="mt-4 text-3xl font-bold tracking-tight text-white">
              From website design to full business systems
            </h3>

            <p class="mt-5 leading-8 text-slate-300">
              My strength is not only writing code, but understanding how websites,
              dashboards, admin panels, workflows and business processes connect
              together into one useful system.
            </p>
          </div>

          <div class="space-y-5">
            {skillMeters.map((skill) => (
              <div>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <p class="font-medium text-white">{skill.label}</p>
                  <p class="text-sm text-slate-400">{skill.level}%</p>
                </div>

                <div class="h-3 overflow-hidden rounded-full bg-white/10">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-[#F08252] to-orange-300"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="relative overflow-hidden px-6 py-24">
  <div class="absolute left-[-12rem] top-24 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl"></div>

  <div class="mx-auto max-w-6xl">
    <SectionTitle
      eyebrow="Projects"
      title="Selected work and systems"
      description="A collection of websites, web applications and business systems built with practical functionality in mind."
    />

    <div class="grid gap-6 lg:grid-cols-2">
      {projects.map((project, index) => (
        <article class={`group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07] ${index === 0 ? "lg:col-span-2" : ""}`}>
          <div class="absolute right-0 top-0 h-32 w-32 rounded-bl-full bg-[#F08252]/10 transition group-hover:bg-[#F08252]/20"></div>

          <div class="relative">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
              <span class="rounded-full border border-[#F08252]/30 bg-[#F08252]/10 px-4 py-2 text-sm font-medium text-orange-200">
                {project.type}
              </span>

              <span class="text-sm font-semibold text-slate-500">
                0{index + 1}
              </span>
            </div>

            <h3 class="text-2xl font-bold tracking-tight text-white md:text-3xl">
              {project.title}
            </h3>

            <p class="mt-4 leading-8 text-slate-300">
              {project.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1.5 text-xs font-medium text-slate-300">
                  {tag}
                </span>
              ))}
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {project.features.map((feature) => (
                <div class="flex items-center gap-3 rounded-2xl bg-slate-950/50 p-3 text-sm text-slate-300">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F08252]/15 text-xs font-bold text-[#F08252]">
                    ✓
                  </span>
                  {feature}
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

    <section id="experience" class="bg-slate-900/50 px-6 py-24">
      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="Experience"
          title="More than 12 years in web development"
          description="Experience across web development, WordPress, business systems, client websites and custom web applications."
        />

        <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
          <div class="grid gap-6 md:grid-cols-3">
            <div>
              <p class="text-4xl font-bold text-[#F08252]">12+</p>
              <p class="mt-2 text-slate-300">Years of experience</p>
            </div>

            <div>
              <p class="text-4xl font-bold text-[#F08252]">100+</p>
              <p class="mt-2 text-slate-300">Websites and web projects</p>
            </div>

            <div>
              <p class="text-4xl font-bold text-[#F08252]">Full-stack</p>
              <p class="mt-2 text-slate-300">Frontend, backend and CMS work</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="px-6 py-24">
      <div class="mx-auto max-w-4xl text-center">
        <SectionTitle
          eyebrow="Contact"
          title="Let’s build something practical"
          description="Contact me for websites, WordPress customisation, Laravel applications, business systems or technical support."
        />

        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="mailto:sid_dus@yahoo.com"
            class="rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white transition hover:bg-orange-500"
          >
            Email Me
          </a>

          <a
            href="https://www.linkedin.com/in/siddhartha-gautam-748935144/"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-[#F08252] hover:text-[#F08252]"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>