---

<BaseLayout
  title="Siddhartha Gautam | Web Developer, WordPress Specialist & System Analyst"
  description="Personal website of Siddhartha Gautam, a web developer, WordPress specialist and system analyst building practical websites, Laravel applications, Angular interfaces and business systems."
  canonical="https://gautamsiddhartha.com.np/"
>
  <Header />

  <main class="min-h-screen">
    <section id="home" class="relative flex min-h-screen items-center overflow-hidden px-6 py-32">
      <div
        class="absolute inset-0 -z-20 bg-[linear-gradient(135deg,#0f172a_0%,#020617_55%,#111827_100%)]"
      >
      </div>

      <div
        class="pulse-soft absolute -left-32 top-24 -z-10 h-80 w-80 rounded-full bg-[#F08252]/20 blur-3xl"
      >
      </div>
      <div
        class="pulse-soft absolute bottom-10 -right-40 -z-10 h-96 w-96 rounded-full bg-orange-500/10 blur-3xl"
      >
      </div>

      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(240,130,82,0.16),_transparent_32%),radial-gradient(circle_at_bottom_right,_rgba(255,255,255,0.06),_transparent_28%)]"
      >
      </div>

      <div
        class="mx-auto grid w-full max-w-6xl gap-14 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"
      >
        <div>
          <p
            class="mb-5 inline-flex rounded-full border border-orange-300/20 bg-orange-300/10 px-4 py-2 text-sm font-medium text-orange-200"
          >
            Available for website, WordPress and custom web system projects
          </p>

          <h1 class="max-w-4xl text-5xl font-bold tracking-tight text-white md:text-7xl">
            Hi, I’m
            <span
              class="block bg-linear-to-r from-[#F08252] to-orange-300 bg-clip-text text-transparent"
            >
              Siddhartha Gautam
            </span>
          </h1>

          <AnimatedRoles />

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            I build fast, practical and business-focused websites and web applications using
            WordPress, Laravel, Angular, PHP, MySQL and modern frontend tools.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {
              ['WordPress', 'Laravel', 'Angular', 'PHP', 'MySQL', 'Tailwind CSS'].map((item) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
                  {item}
                </span>
              ))
            }
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#projects"
              class="rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-500"
            >
              View My Work
            </a>

            <a
              href="#contact"
              class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-[#F08252] hover:text-[#F08252]"
            >
              Contact Me
            </a>
          </div>

          <div class="mt-12 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/10 pt-8">
            <div>
              <p class="text-3xl font-bold text-white">12+</p>
              <p class="mt-1 text-sm text-slate-400">Years experience</p>
            </div>

            <div>
              <p class="text-3xl font-bold text-white">100+</p>
              <p class="mt-1 text-sm text-slate-400">Web projects</p>
            </div>

            <div>
              <p class="text-3xl font-bold text-white">Full</p>
              <p class="mt-1 text-sm text-slate-400">Stack approach</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div
            class="float-soft absolute -right-4 -top-6 hidden rounded-2xl border border-white/10 bg-white/10 px-5 py-4 shadow-2xl backdrop-blur md:block"
          >
            <p class="text-sm font-medium text-slate-300">Current stack</p>
            <p class="mt-1 text-lg font-semibold text-white">Astro + Tailwind</p>
          </div>

          <div class="rounded-4xl border border-white/10 bg-white/5 p-4 shadow-2xl backdrop-blur">
            <div class="overflow-hidden rounded-3xl bg-slate-900">
              <div class="bg-linear-to-br from-[#F08252] via-orange-500 to-slate-800 p-1">
                <div class="rounded-[1.35rem] bg-slate-950 p-6">
                  <div class="flex items-center gap-5">
                    <div
                      class="relative h-24 w-24 shrink-0 overflow-hidden rounded-3xl border-2 border-[#F08252]/60 bg-slate-900 shadow-lg shadow-orange-500/20"
                    >
                      <img
                        src="/images/profile/siddhartha.webp"
                        alt="Siddhartha Gautam"
                        loading="eager"
                        class="h-full w-full object-cover"
                      />

                      <div class="absolute inset-0 rounded-3xl ring-1 ring-inset ring-white/10">
                      </div>
                    </div>

                    <div>
                      <p class="text-2xl font-bold text-white">Siddhartha Gautam</p>
                      <p class="mt-1 text-sm text-slate-400">Developer / System Analyst</p>
                    </div>
                  </div>

                  <div class="mt-8 space-y-4">
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                      <p class="text-sm text-slate-400">Main focus</p>
                      <p class="mt-2 text-lg font-semibold text-white">
                        Lightweight, fast and maintainable websites
                      </p>
                    </div>

                    <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                      <p class="text-sm text-slate-400">Project type</p>
                      <p class="mt-2 text-lg font-semibold text-white">
                        Personal portfolio replacing WordPress
                      </p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                      <div class="rounded-2xl bg-white/5 p-4">
                        <p class="text-2xl font-bold text-[#F08252]">No</p>
                        <p class="mt-1 text-sm text-slate-400">Database</p>
                      </div>

                      <div class="rounded-2xl bg-white/5 p-4">
                        <p class="text-2xl font-bold text-[#F08252]">No</p>
                        <p class="mt-1 text-sm text-slate-400">Plugins</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="border-t border-white/10 bg-white/3 p-6">
                <div class="flex flex-wrap gap-2">
                  {
                    ['Fast', 'SEO-ready', 'Responsive', 'Render deploy'].map((item) => (
                      <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">
                        {item}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <div
            class="float-soft absolute -bottom-6 -left-4 hidden rounded-2xl border border-white/10 bg-slate-900 px-5 py-4 shadow-2xl md:block"
          >
            <p class="text-sm text-slate-400">Website goal</p>
            <p class="mt-1 font-semibold text-white">Fast personal brand site</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="relative overflow-hidden px-6 py-24">
      <div class="absolute -left-48 top-20 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl">
      </div>

      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="About"
          title="Developer, problem solver and system thinker"
          description="I create practical digital solutions that combine clean design, reliable development and business-focused functionality."
        />

        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div class="rounded-4xl border border-white/10 bg-white/5 p-8 shadow-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F08252]">
              Personal Profile
            </p>

            <h3 class="mt-5 text-3xl font-bold tracking-tight text-white">
              Building websites and systems that are practical, fast and useful.
            </h3>

            <div class="mt-6 space-y-5 text-lg leading-8 text-slate-300">
              <p>
                I am a web developer and system analyst with experience across WordPress, Elementor,
                PHP, Laravel, Angular, MySQL and modern frontend development.
              </p>

              <p>
                My work focuses on solving real problems through clean websites, practical business
                systems and maintainable digital solutions. I enjoy working on projects where
                design, functionality and business needs come together.
              </p>

              <p>
                This website is being rebuilt as a lightweight static site to replace WordPress,
                improve speed, reduce maintenance and create a cleaner personal brand presence.
              </p>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="rounded-2xl bg-slate-950/70 p-5">
                <p class="text-3xl font-bold text-[#F08252]">12+</p>
                <p class="mt-1 text-sm text-slate-400">Years experience</p>
              </div>

              <div class="rounded-2xl bg-slate-950/70 p-5">
                <p class="text-3xl font-bold text-[#F08252]">100+</p>
                <p class="mt-1 text-sm text-slate-400">Web projects</p>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="grid gap-6">
              {
                aboutCards.map((card) => (
                  <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07]">
                    <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F08252]/15 text-lg font-bold text-[#F08252]">
                      ✓
                    </div>

                    <h3 class="text-xl font-semibold text-white">{card.title}</h3>

                    <p class="mt-3 leading-7 text-slate-300">{card.text}</p>
                  </article>
                ))
              }
            </div>

            <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6">
              <h3 class="text-xl font-semibold text-white">Current focus areas</h3>

              <div class="mt-5 flex flex-wrap gap-3">
                {
                  focusAreas.map((item) => (
                    <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
                      {item}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="relative overflow-hidden bg-slate-900/50 px-6 py-24">
      <div class="absolute -right-48 top-24 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl">
      </div>

      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="Skills"
          title="Technology stack and practical expertise"
          description="A balanced mix of frontend, backend, WordPress, CMS and business system development skills."
        />

        <div class="grid gap-6 lg:grid-cols-2">
          {
            skillGroups.map((group) => (
              <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07]">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-2xl font-semibold text-white">{group.category}</h3>

                    <p class="mt-3 leading-7 text-slate-300">{group.description}</p>
                  </div>

                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#F08252]/15 text-xl font-bold text-[#F08252]">
                    #
                  </div>
                </div>

                <div class="mt-6 flex flex-wrap gap-3">
                  {group.items.map((item) => (
                    <span class="rounded-full border border-white/10 bg-slate-950/60 px-4 py-2 text-sm text-slate-300 transition group-hover:border-[#F08252]/30">
                      {item}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-8 rounded-4xl border border-white/10 bg-slate-950/70 p-8">
          <div class="mb-10 text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F08252]">
              My Expertise
            </p>

            <h3 class="mt-4 text-3xl font-bold tracking-tight text-white md:text-4xl">
              Technical & Professional Skills
            </h3>

            <p class="mx-auto mt-4 max-w-2xl leading-8 text-slate-300">
              A practical combination of development skills, business understanding and
              communication-focused work experience.
            </p>
          </div>

          <div class="grid gap-10 lg:grid-cols-2">
            <div>
              <h4 class="mb-6 text-2xl font-bold text-white">Technical Skills</h4>

              <div class="space-y-6">
                {
                  technicalSkills.map((skill) => (
                    <div>
                      <div class="mb-2 flex items-center justify-between gap-4">
                        <p class="font-medium tracking-wide text-slate-200">{skill.label}</p>

                        <p class="text-sm font-semibold text-[#F08252]">{skill.level}%</p>
                      </div>

                      <div class="h-4 overflow-hidden rounded-full bg-white/10">
                        <div
                          class="h-full rounded-full bg-linear-to-r from-[#F08252] to-orange-300"
                          style={`width: ${skill.level}%`}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div>
              <h4 class="mb-6 text-2xl font-bold text-white">Professional Skills</h4>

              <div class="space-y-6">
                {
                  professionalSkills.map((skill) => (
                    <div>
                      <div class="mb-2 flex items-center justify-between gap-4">
                        <p class="font-medium tracking-wide text-slate-200">{skill.label}</p>

                        <p class="text-sm font-semibold text-[#F08252]">{skill.level}%</p>
                      </div>

                      <div class="h-4 overflow-hidden rounded-full bg-white/10">
                        <div
                          class="h-full rounded-full bg-linear-to-r from-[#F08252] to-orange-300"
                          style={`width: ${skill.level}%`}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="relative overflow-hidden px-6 py-24">
      <div class="absolute -left-48 top-24 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl">
      </div>

      <div class="mx-auto max-w-6xl">
        <SectionTitle
          eyebrow="Projects"
          title="Selected work and systems"
          description="A collection of websites, web applications and business systems built with practical functionality in mind."
        />

        <div class="grid gap-6 lg:grid-cols-2">
          {
            projects.map((project, index) => (
              <article
                class={`group relative overflow-hidden rounded-4xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-white/[0.07] ${index === 0 ? 'lg:col-span-2' : ''}`}
              >
                <div class="absolute right-0 top-0 h-32 w-32 rounded-bl-full bg-[#F08252]/10 transition group-hover:bg-[#F08252]/20" />
                <div class="mb-6 overflow-hidden rounded-3xl border border-white/10 bg-slate-950">
                  <img
                    src={project.image}
                    alt={`${project.title} project preview`}
                    loading="lazy"
                    class="aspect-video w-full object-cover opacity-90 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
                  />
                </div>
                <div class="relative">
                  <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
                    <span class="rounded-full border border-[#F08252]/30 bg-[#F08252]/10 px-4 py-2 text-sm font-medium text-orange-200">
                      {project.type}
                    </span>

                    <span class="text-sm font-semibold text-slate-500">0{index + 1}</span>
                  </div>

                  <h3 class="text-2xl font-bold tracking-tight text-white md:text-3xl">
                    {project.title}
                  </h3>

                  <p class="mt-4 leading-8 text-slate-300">{project.description}</p>

                  <div class="mt-6 flex flex-wrap gap-3">
                    {project.tags.map((tag) => (
                      <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1.5 text-xs font-medium text-slate-300">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="mt-6 grid gap-3 sm:grid-cols-2">
                    {project.features.map((feature) => (
                      <div class="flex items-center gap-3 rounded-2xl bg-slate-950/50 p-3 text-sm text-slate-300">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F08252]/15 text-xs font-bold text-[#F08252]">
                          ✓
                        </span>
                        {feature}
                      </div>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
