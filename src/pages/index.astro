---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import SectionTitle from '../components/SectionTitle.astro'
import AnimatedRoles from '../components/AnimatedRoles.astro'
import Footer from '../components/Footer.astro'
import SiteEnhancements from '../components/SiteEnhancements.astro'
import TechMarquee from '../components/TechMarquee.astro'

import HeroSection from '../components/sections/HeroSection.astro'
import AboutSection from '../components/sections/AboutSection.astro'
import ProcessSection from '../components/sections/ProcessSection.astro'
import SkillsSection from '../components/sections/SkillsSection.astro'
import ProjectsSection from '../components/sections/ProjectsSection.astro'
import ExperienceSection from '../components/sections/ExperienceSection.astro'
import TestimonialsSection from '../components/sections/TestimonialsSection.astro'
import AvailabilitySection from '../components/sections/AvailabilitySection.astro'
import ContactSection from '../components/sections/ContactSection.astro'

import {
  aboutCards,
  focusAreas,
  skillGroups,
  technicalSkills,
  professionalSkills,
  projects,
  experiences,
  testimonials,
  contactMethods,
  serviceEnquiries,
  processSteps
} from '../data/home'
---

<BaseLayout
  title="Siddhartha Gautam | Web Developer, WordPress Specialist & System Analyst"
  description="Personal website of Siddhartha Gautam, a web developer, WordPress specialist and system analyst building practical websites, Laravel applications, Angular interfaces and business systems."
  canonical="https://gautamsiddhartha.com.np/"
>
  <Header />
  <SiteEnhancements />

  <main class="min-h-screen">
    <HeroSection />
    <AboutSection aboutCards={aboutCards} focusAreas={focusAreas} />
    <ProcessSection processSteps={processSteps} />
    <SkillsSection
      skillGroups={skillGroups}
      technicalSkills={technicalSkills}
      professionalSkills={professionalSkills}
    />
    <ProjectsSection projects={projects} />
    <ExperienceSection experiences={experiences} />
    <TestimonialsSection testimonials={testimonials} />
    <AvailabilitySection />
    <ContactSection contactMethods={contactMethods} serviceEnquiries={serviceEnquiries} />
  </main>
  <Footer />
</BaseLayout>
