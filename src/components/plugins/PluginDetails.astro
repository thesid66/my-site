---
import type { PluginLandingData } from '../../data/plugins'

type Props = {
  plugin: PluginLandingData
}

const { plugin } = Astro.props
---

<div class="border-y border-white/10 bg-white/[0.025] px-6">
  <div class="mx-auto grid max-w-6xl sm:grid-cols-2 lg:grid-cols-4">
    {
      plugin.trustStatements.map((statement, index) => (
        <div class={`py-6 sm:px-6 ${index > 0 ? 'border-t border-white/10 sm:border-t-0' : ''} ${index % 2 === 1 ? 'sm:border-l sm:border-white/10' : ''} ${index > 1 ? 'lg:border-l lg:border-white/10' : ''}`}>
          <strong class="block text-white">{statement.title}</strong>
          <span class="mt-1 block text-sm text-slate-500">{statement.description}</span>
        </div>
      ))
    }
  </div>
</div>

<section id="features" class="relative overflow-hidden px-6 py-24">
  <div class="absolute -left-48 top-20 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl"></div>
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-3xl">
      <p class="text-sm font-semibold text-[#F08252]">Built for real WordPress libraries</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white md:text-5xl">
        Image conversion that stays understandable.
      </h2>
      <p class="mt-5 text-lg leading-8 text-slate-400">
        Practical controls, visible progress, and a safe delivery path from the Media Library to the frontend.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        plugin.features.map((feature) => (
          <article class="rounded-3xl border border-white/10 bg-white/5 p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#F08252]/15 font-bold text-[#F08252]">
              {feature.icon}
            </span>
            <h3 class="mt-7 text-xl font-bold text-white">{feature.title}</h3>
            <p class="mt-3 leading-7 text-slate-400">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="workflow" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-3xl">
      <p class="text-sm font-semibold text-[#F08252]">How it works</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white md:text-5xl">
        From upload to a modern browser-ready image.
      </h2>
    </div>

    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        plugin.workflow.map((step, index) => (
          <li class="border-t-2 border-[#F08252] bg-linear-to-b from-[#F08252]/10 to-transparent px-6 py-7">
            <span class="text-sm font-bold text-[#F08252]">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-7 text-xl font-bold text-white">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="requirements" class="px-6 py-24">
  <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2">
    <article class="rounded-4xl border border-white/10 bg-white/5 p-8 md:p-10">
      <p class="text-sm font-semibold text-[#F08252]">Compatibility</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">
        Fits the WordPress workflow.
      </h2>
      <ul class="mt-8 space-y-4">
        {
          plugin.compatibility.map((item) => (
            <li class="flex gap-3 text-slate-300">
              <span class="font-bold text-[#F08252]" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-4xl border border-white/10 bg-white/5 p-8 md:p-10">
      <p class="text-sm font-semibold text-[#F08252]">Server requirements</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">
        Conversion stays on your server.
      </h2>
      <ul class="mt-8 space-y-4">
        {
          plugin.requirements.map((item) => (
            <li class="flex gap-3 text-slate-300">
              <span class="font-bold text-[#F08252]" aria-hidden="true">•</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

