---
import Footer from '../Footer.astro'
import type { PluginLandingData } from '../../data/plugins'
import PluginDetails from './PluginDetails.astro'
import PluginFaq from './PluginFaq.astro'
import PluginHeader from './PluginHeader.astro'
import PluginHero from './PluginHero.astro'
import RupantaSearchContent from './RupantaSearchContent.astro'

type Props = {
  plugin: PluginLandingData
}

const { plugin } = Astro.props
---

<PluginHeader plugin={plugin} />

<main class="min-h-screen">
  <PluginHero plugin={plugin} />
  <PluginDetails plugin={plugin} />
  {plugin.slug === 'rupanta-media-converter' && <RupantaSearchContent />}
  <PluginFaq plugin={plugin} />

  <section id="download" class="px-6 py-24">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 rounded-4xl border border-[#F08252]/30 bg-[radial-gradient(circle_at_85%_20%,rgba(240,130,82,0.24),transparent_32%),#0f172a] p-8 md:flex-row md:items-center md:justify-between md:p-12">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
          Make your media library modern.
        </h2>
        <p class="mt-3 leading-7 text-slate-400">
          Install {plugin.name} free from the official WordPress plugin directory.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={plugin.wordpressUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-500"
        >
          Download on WordPress.org
        </a>
        {
          plugin.sourceUrl && (
            <a
              href={plugin.sourceUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-[#F08252] hover:text-[#F08252]"
            >
              {plugin.sourceLabel ?? 'View source'}
            </a>
          )
        }
      </div>
    </div>
  </section>
</main>

<Footer linkPrefix="/" />
