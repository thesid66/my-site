---
import type { PluginLandingData } from '../../data/plugins'

type Props = {
  plugin: PluginLandingData
}

const { plugin } = Astro.props
---

<section id="faq" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-3xl">
      <p class="text-sm font-semibold text-[#F08252]">Common questions</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white md:text-5xl">
        Clear answers before installation.
      </h2>
    </div>

    <div class="space-y-3">
      {
        plugin.faqs.map((faq) => (
          <details class="group rounded-2xl border border-white/10 bg-white/[0.04] px-6 py-5 open:border-[#F08252]/40 open:bg-white/[0.06]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold text-white">
              <span>{faq.question}</span>
              <span class="text-xl text-[#F08252] transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-3xl pt-4 leading-7 text-slate-400">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

