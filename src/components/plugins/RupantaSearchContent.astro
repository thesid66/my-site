const useCases = [
  {
    title: 'Convert JPG and JPEG to WebP in WordPress',
    description:
      'Generate .webp versions of WordPress JPEG uploads and their supported image sizes while keeping the original JPG files available as a safe fallback.'
  },
  {
    title: 'Convert PNG to AVIF or WebP',
    description:
      'Create modern AVIF or WebP copies of PNG images, including supported transparent images, without replacing or deleting the original PNG.'
  },
  {
    title: 'Bulk convert an existing WordPress Media Library',
    description:
      'Run background batch conversion for previously uploaded images. Monitor converted, pending and failed attachments through progress indicators and per-file logs.'
  },
  {
    title: 'Automatically convert new WordPress image uploads',
    description:
      'Enable WebP, AVIF or both so new JPEG and PNG files added to WordPress Media Library are processed using the server’s supported image encoder.'
  },
  {
    title: 'Deliver modern image formats with Elementor and Divi',
    description:
      'Serve generated WebP and AVIF files for compatible WordPress attachment images and supported Elementor or Divi output while retaining an original-image fallback.'
  },
  {
    title: 'Use a free image converter without an external API',
    description:
      'Keep image processing on your WordPress hosting server through GD or Imagick. There is no remote conversion service, subscription or plugin-imposed image quota.'
  }
