---
import type { PluginLandingData } from '../../data/plugins'

type Props = {
  plugin: PluginLandingData
}

const { plugin } = Astro.props
const { converter } = plugin.screenshots
---

<section id="plugin-home" class="relative overflow-hidden px-6 py-14 md:py-20">
  <div class="absolute inset-0 -z-20 bg-[linear-gradient(135deg,#0f172a_0%,#020617_55%,#111827_100%)]"></div>
  <div class="absolute -left-32 top-12 -z-10 h-96 w-96 rounded-full bg-[#F08252]/15 blur-3xl"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(240,130,82,0.14),_transparent_32%)]"></div>

  <div class="mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-2 lg:gap-12 lg:items-center">
    <div class="min-w-0">
      <p class="inline-flex rounded-full border border-[#F08252]/25 bg-[#F08252]/10 px-4 py-2 text-sm font-semibold text-orange-200">
        {plugin.badge}
      </p>

      <h1 class="mt-7 text-[2.5rem] font-bold leading-[1.02] tracking-[-0.055em] text-white sm:text-5xl xl:text-6xl">
        <span class="block text-balance">{plugin.headline}</span>
        <span class="block text-[#F08252]">{plugin.accentHeadline}</span>
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">{plugin.description}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={plugin.wordpressUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#F08252] px-6 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-500"
        >
          Get it on WordPress.org
        </a>
        <a
          href="#workflow"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-[#F08252] hover:text-[#F08252]"
        >
          How to install
        </a>
      </div>

    </div>

    <figure class="relative min-w-0">
      <div class="absolute inset-8 -z-10 rounded-full bg-[#F08252]/15 blur-3xl"></div>
      <a
        href={converter.src}
        aria-label="Open the full-size Converter screenshot"
        class="block rounded-3xl border border-white/10 bg-white/5 p-2 shadow-2xl backdrop-blur transition hover:border-[#F08252] sm:p-3 md:rounded-4xl md:p-4"
      >
        <div class="md:rounded-3xl md:bg-linear-to-br md:from-[#F08252] md:via-orange-500 md:to-slate-800 md:p-1">
          <img
            src={converter.src}
            width={converter.width}
            height={converter.height}
            alt={converter.alt}
            fetchpriority="high"
            class="h-auto w-full rounded-2xl md:rounded-[1.35rem]"
          />
        </div>
      </a>
      <figcaption
        class="float-soft pointer-events-none absolute -right-4 -top-6 z-30 hidden rounded-2xl border border-white/10 bg-slate-800/90 px-5 py-4 text-sm font-semibold text-white shadow-2xl backdrop-blur md:block"
      >
        Track progress and check server support.
      </figcaption>
    </figure>
  </div>
</section>
