---
import type { ContactMethod } from '../../data/home'
import SectionTitle from '../SectionTitle.astro'

type Props = {
  contactMethods: ContactMethod[]
  serviceEnquiries: string[]
}

const { contactMethods, serviceEnquiries } = Astro.props
---

<section id="contact" class="relative overflow-hidden px-6 py-24">
  <div class="absolute -left-48 top-24 -z-10 h-96 w-96 rounded-full bg-[#F08252]/10 blur-3xl"></div>
  <div class="absolute bottom-0 -right-48 -z-10 h-96 w-96 rounded-full bg-orange-500/10 blur-3xl">
  </div>

  <div class="mx-auto max-w-6xl">
    <SectionTitle
      eyebrow="Contact"
      title="Let’s build something practical"
      description="Contact me for websites, WordPress customisation, Laravel applications, business systems or technical support."
    />

    <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-start">
      <div class="rounded-4xl border border-white/10 bg-white/5 p-8 shadow-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F08252]">
          Start a Conversation
        </p>

        <h3 class="mt-5 text-3xl font-bold tracking-tight text-white">
          Have a project, idea or system requirement?
        </h3>

        <p class="mt-5 leading-8 text-slate-300">
          I can help with lightweight websites, WordPress improvements, Laravel applications,
          frontend interfaces and business-focused digital systems. Share what you are trying to
          build, improve or migrate.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            serviceEnquiries.map((item) => (
              <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-950/60 p-4 text-sm text-slate-300">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#F08252]/15 text-xs font-bold text-[#F08252]">
                  ✓
                </span>
                {item}
              </div>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="mailto:sid_dus@yahoo.com"
            class="rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-500"
          >
            Send Email
          </a>

          <a
            href="https://wa.me/9779814999982"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-[#F08252] hover:text-[#F08252]"
          >
            Message on WhatsApp
          </a>
        </div>
      </div>

      <div class="grid gap-4">
        {
          contactMethods.map((method) => (
            <a
              href={method.href}
              target={method.href.startsWith('http') ? '_blank' : undefined}
              rel={method.href.startsWith('http') ? 'noreferrer' : undefined}
              class="group rounded-3xl border border-white/10 bg-slate-900/70 p-6 transition hover:-translate-y-1 hover:border-[#F08252]/50 hover:bg-slate-900"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#F08252]">
                    {method.label}
                  </p>

                  <h3 class="mt-3 wrap-break-word text-xl font-semibold text-white">
                    {method.value}
                  </h3>

                  <p class="mt-3 leading-7 text-slate-400">{method.note}</p>
                </div>

                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/5 text-lg text-slate-300 transition group-hover:bg-[#F08252] group-hover:text-white">
                  ↗
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 rounded-4xl border border-white/10 bg-linear-to-r from-[#F08252]/20 to-orange-500/10 p-8 text-center"
    >
      <h3 class="text-2xl font-bold text-white md:text-3xl">
        Ready to discuss your next digital project?
      </h3>

      <p class="mx-auto mt-4 max-w-2xl leading-8 text-slate-300">
        Whether it is a new website, a WordPress improvement, a custom web application or a business
        system, I can help you plan and build it with a practical approach.
      </p>

      <a
        href="mailto:sid_dus@yahoo.com"
        class="mt-6 inline-flex rounded-full bg-[#F08252] px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-orange-500"
      >
        Start a Project Enquiry
      </a>
    </div>
  </div>
</section>
